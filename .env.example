# DeepSeek (OpenAI-compatible API). If unset, ACP features that need the model will error or use local fallbacks.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Merchant block injected into prompts and local fallback
MERCHANT_ID=getmainelobster
MERCHANT_NAME=Get Maine Lobster
DEFAULT_SHIPPING_REGIONS=US
